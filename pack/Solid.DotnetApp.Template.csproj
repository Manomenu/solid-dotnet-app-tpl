<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Solid.DotnetApp.Template</PackageId>
    <Version>1.0.0</Version>
    <Authors>solid-dotnet-app-tpl</Authors>
    <Description>An agent-friendly .NET 10 application: ASP.NET Core, PostgreSQL, React, strict analyzers, architecture tests and one quality gate.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Content
      Include="..\**\*"
      Exclude="..\**\bin\**;..\**\obj\**;..\**\node_modules\**;..\.git\**;..\pack\**;..\.artifacts\**;..\**\TestResults\**;..\**\StrykerOutput\**;..\**\dist\**;..\.env;..\CLAUDE.local.md"
      PackagePath="content"
    />
  </ItemGroup>
</Project>
