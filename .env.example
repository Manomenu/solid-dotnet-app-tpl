# Copy to .env (gitignored). Every line is optional: the defaults in compose.yaml work for `just up`.
# IMAGE_TAG=local
# WEB_PORT=8190
# POSTGRES_USER=myapp
# POSTGRES_PASSWORD=myapp
# POSTGRES_DB=myapp
# An external PostgreSQL: set this and start without the db profile (docker compose up -d).
# ConnectionStrings__Default=Host=db.example.internal;Port=5432;Database=myapp;Username=myapp;Password=change-me
# API_UPSTREAM=http://server:6300
