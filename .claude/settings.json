{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/Myapp.Web/node_modules/.bin/suwgate\" hook stop",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/Myapp.Web/node_modules/.bin/suwgate\" hook guard-edit"
          }
        ]
      }
    ]
  }
}
