root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,slnx,config}]
indent_size = 2

[*.{cs,csproj,props,targets}]
max_line_length = 140

[Myapp.Server.Tests/**.cs]
dotnet_diagnostic.CA2100.severity = none
