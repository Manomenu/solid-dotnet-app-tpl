<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="gate">
    <PackageVersion Include="Suwgate.Architecture" Version="0.4.0" />
    <PackageVersion Include="Suwgate.Database" Version="0.4.0" />
  </ItemGroup>
  <ItemGroup Label="server">
    <PackageVersion Include="Suwbackkit.Server" Version="0.5.0" />
    <PackageVersion Include="Suwbackkit.Postgres" Version="0.5.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
  </ItemGroup>
  <ItemGroup Label="tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Suwbackkit.Testing" Version="0.5.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
