{
  "openapi": "3.1.1",
  "info": {
    "title": "Myapp.Server | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "HealthEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "tags": [
          "NoteEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "NoteEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewNote"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalOfNoteRefusalAndMistakeOfNoteRefusal"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "MistakeOfNoteRefusal": {
        "required": [
          "code",
          "message",
          "fix"
        ],
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/NoteRefusal"
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "at": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "NewNote": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Note": {
        "required": [
          "id",
          "text",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NoteRefusal": {
        "enum": [
          "note.textInvalid"
        ]
      },
      "RefusalOfNoteRefusalAndMistakeOfNoteRefusal": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "traceId",
          "code"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/NoteRefusal"
          },
          "mistakes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/MistakeOfNoteRefusal"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "HealthEndpoints"
    },
    {
      "name": "NoteEndpoints"
    }
  ]
}